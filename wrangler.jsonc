// Worker de QA (Cloudflare Workers Builds, production branch: qa).
// "name" debe coincidir con el nombre del Worker en Cloudflare o el build falla.
// Producción NO usa este archivo: se despliega en Railway desde master.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prime-code-landing-qa",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
