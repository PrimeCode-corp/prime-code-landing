---
import { Image } from 'astro:assets';
import primeCodeSymbol from '../../assets/prime-code-symbol.png';
---

<header
  id="header"
  class="section-frame absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-x-8 gap-y-4 pt-[calc(var(--u)*1.75)] pb-[calc(var(--u)*1.6)] text-crema"
>
  <a
    href="#inicio"
    aria-label="Prime Code, inicio"
    class="flex items-center rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste"
  >
    <Image
      src={primeCodeSymbol}
      alt=""
      widths={[80, 160]}
      sizes="70px"
      format="webp"
      quality={100}
      loading="eager"
      class="block h-[max(26px,calc(var(--u)*2.2))] w-auto"
    />
  </a>

  <nav
    aria-label="Principal"
    class="flex items-center gap-x-[calc(var(--u)*1.9)] gap-y-3 text-[max(14px,calc(var(--u)*0.98))]"
  >
    <a href="#inicio" class="rounded transition-colors hover:text-celeste focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste">Inicio</a>
    <a href="#nosotros" class="rounded transition-colors hover:text-celeste focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste">Nosotros</a>
    <a href="#servicios" class="inline-flex items-center gap-2 rounded transition-colors hover:text-celeste focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste">
      Servicios
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <a href="#clientes" class="rounded transition-colors hover:text-celeste focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste">Clientes</a>
    <a href="#contacto" class="rounded transition-colors hover:text-celeste focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-celeste">Contacto</a>
  </nav>
</header>
