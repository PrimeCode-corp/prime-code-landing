---
interface Props {
  kind: 'chevrons' | 'calendar' | 'bars' | 'pin' | 'pulse';
  delay: string;
}

const { kind, delay } = Astro.props;
---

<svg
  width="36"
  height="36"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class:list={['h-auto w-[max(26px,calc(var(--u)*2.1))] text-crema animate-differentials-icon', delay]}
>
  {kind === 'chevrons' && (
    <g fill="currentColor">
      <path d="M2 5h3.5l5 7-5 7H2l5-7z" />
      <path d="M10 2h4.5l7 10-7 10H10l7-10z" />
    </g>
  )}
  {kind === 'calendar' && (
    <g>
      <g stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
        <rect x="3" y="5" width="18" height="16" />
        <path d="M3 10h18M8 3v4M16 3v4" />
      </g>
      <path d="M8.5 15.5l2.5 2.5 4.5-5" class="stroke-celeste" stroke-width="2" stroke-linecap="square" />
    </g>
  )}
  {kind === 'bars' && (
    <g fill="currentColor">
      <rect x="2" y="4" width="8" height="3" />
      <rect x="2" y="10.5" width="13" height="3" />
      <rect x="2" y="17" width="20" height="3" />
    </g>
  )}
  {kind === 'pin' && (
    <g>
      <path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z" stroke="currentColor" stroke-width="1.8" />
      <rect x="10.5" y="8.5" width="3" height="3" fill="currentColor" />
    </g>
  )}
  {kind === 'pulse' && (
    <path d="M3 12h4l3-4 4 8 3-4h4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  )}
</svg>
